{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Roadmap Assessment",
  "type": "object",
  "required": ["company_profile", "operating_metrics", "business_functions", "role_groups", "workflows", "technology_stack", "data_assets", "document_assets", "pain_points", "ai_readiness", "governance_profile", "management_decisions", "opportunities", "roadmap_phases"],
  "properties": {
    "company_profile": { "type": "object", "required": ["company_name", "industry", "employee_count", "locations", "management_structure", "customer_types", "revenue_sources", "strategic_priorities"] },
    "operating_metrics": { "type": "array", "items": { "$ref": "#/$defs/operating_metric" } },
    "business_functions": { "type": "array", "items": { "type": "object", "required": ["function_name", "employee_count", "manager_owner", "importance", "pain_level", "systems_used"] } },
    "role_groups": { "type": "array", "items": { "type": "object", "required": ["role_name", "function_name", "headcount", "responsibilities", "pain_points"] } },
    "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } },
    "technology_stack": { "type": "array", "items": { "type": "object", "required": ["system_name", "function_served", "data_stored", "export_capability", "integration_capability", "limitations"] } },
    "data_assets": { "type": "array", "items": { "type": "object", "required": ["asset_name", "source_system", "owner", "format", "cleanliness", "accessibility", "sensitivity", "ai_usability"] } },
    "document_assets": { "type": "array", "items": { "type": "object", "required": ["document_type", "location", "owner", "quality", "ai_use_cases"] } },
    "pain_points": { "type": "array", "items": { "type": "object", "required": ["pain_point", "workflow_name", "severity", "time_cost", "customer_impact", "employee_impact", "root_cause"] } },
    "ai_readiness": { "type": "object", "required": ["current_ai_use", "leadership_support", "employee_readiness", "data_availability", "data_organization", "process_documentation", "governance_maturity", "implementation_capacity", "budget_appetite", "timeline_expectation"] },
    "governance_profile": { "type": "object", "required": ["sensitive_data_types", "requires_human_approval", "regulated_constraints", "vendor_or_customer_data_rules"] },
    "management_decisions": { "type": "array", "items": { "type": "string" } },
    "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
    "roadmap_phases": { "type": "array", "items": { "type": "object", "required": ["phase_name", "timeframe", "objectives", "opportunity_names", "dependencies", "success_measures"] } }
  },
  "$defs": {
    "score": { "type": "integer", "minimum": 1, "maximum": 5 },
    "metric_target": { "type": "object", "required": ["metric_name", "baseline", "target", "measurement_period", "source"], "properties": { "metric_name": { "type": "string" }, "baseline": { "type": "string" }, "target": { "type": "string" }, "measurement_period": { "type": "string" }, "source": { "type": "string" } } },
    "operating_metric": { "type": "object", "required": ["metric_name", "value", "unit", "period", "source", "business_context"], "properties": { "metric_name": { "type": "string" }, "value": { "type": "number" }, "unit": { "type": "string" }, "period": { "type": "string" }, "source": { "type": "string" }, "business_context": { "type": "string" } } },
    "workflow": { "type": "object", "required": ["workflow_name", "function_name", "owner", "steps", "systems_used", "documents_used", "frequency", "monthly_volume", "time_per_instance_minutes", "weekly_time_cost_hours", "bottlenecks", "customer_impact", "financial_impact", "data_sensitivity", "process_maturity", "data_readiness", "data_sources", "business_impact", "baseline_metrics", "target_metrics", "implementation_dependencies", "suggested_ai_use_cases", "roadmap_phase", "pilot_timing", "success_measures", "implementation_complexity_factors"], "properties": { "workflow_name": { "type": "string" }, "function_name": { "type": "string" }, "owner": { "type": "string" }, "steps": { "type": "array", "items": { "type": "string" } }, "systems_used": { "type": "array", "items": { "type": "string" } }, "documents_used": { "type": "array", "items": { "type": "string" } }, "frequency": { "type": "string" }, "monthly_volume": { "type": "number" }, "time_per_instance_minutes": { "type": "number" }, "weekly_time_cost_hours": { "type": "number" }, "bottlenecks": { "type": "array", "items": { "type": "string" } }, "customer_impact": { "$ref": "#/$defs/score" }, "financial_impact": { "$ref": "#/$defs/score" }, "data_sensitivity": { "$ref": "#/$defs/score" }, "process_maturity": { "$ref": "#/$defs/score" }, "data_readiness": { "$ref": "#/$defs/score" }, "data_sources": { "type": "array", "items": { "type": "string" } }, "business_impact": { "type": "string" }, "baseline_metrics": { "type": "array", "items": { "$ref": "#/$defs/metric_target" } }, "target_metrics": { "type": "array", "items": { "$ref": "#/$defs/metric_target" } }, "implementation_dependencies": { "type": "array", "items": { "type": "string" } }, "suggested_ai_use_cases": { "type": "array", "items": { "type": "string" } }, "roadmap_phase": { "type": "string" }, "pilot_timing": { "type": "string" }, "success_measures": { "type": "array", "items": { "type": "string" } }, "implementation_complexity_factors": { "type": "array", "items": { "type": "string" } } } },
    "opportunity": { "type": "object", "required": ["opportunity_name", "related_workflow", "description", "total_score", "classification", "recommended_phase", "time_to_pilot", "success_metrics", "owner", "business_evidence", "baseline_metrics", "target_metrics", "implementation_dependencies", "tool_categories"] }
  }
}
